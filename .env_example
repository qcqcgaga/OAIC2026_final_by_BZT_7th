# ===========================================================================
# Codex 路线环境变量模板（复制为 Codex/.env 后填写）
# ---------------------------------------------------------------------------
# 本文件只放**凭据与数值型调优**。所有功能开关（含执行复杂度档位）都不再是环
# 境变量，唯一事实来源是 Codex/main.py 顶部的 FEATURE_FLAGS 表 +
# ARCBENCH_EFFORT_DEFAULT 常量。
#
# 为什么开关不走环境变量（2026-09-23）：
#   - 平台 runner 只注入它自己的已知变量清单（OPENAI_*/MODEL/VISUAL_*/ARC_DEBUG），
#     路线特有的 ARCBENCH_* 在平台上是空的；本地 .env 又不进 staging、不进产物。
#     所以"环境变量里设了"从来不等于"平台跑了"（平台日志曾显示已设为 0 的
#     开关仍被读取并执行）。
#   - .env 的行尾 `# 注释` 会被当成值的一部分，反向键会被判成"开"——同一行写法
#     在两个键上含义相反，是不稳定因素。
#   - 现在残留的旧开关键只会在启动时打一条 `[codex] WARNING: ... no longer
#     control anything` 提醒，取值与表里一致时连提醒都不打。
# ---------------------------------------------------------------------------
#   - 本地模拟器查找顺序：--env-file > 模拟器目录/.env > 路线目录/.env
#     （只取第一个存在的）
#   - 值只注入容器，不写进日志；.env 不进 staging、不进产物
#   - 本文件（.env_example）是模板、进 git；.env 被 .gitignore 忽略、不进 git
# ===========================================================================

# ---------------------------------------------------------------------------
# 一、模型凭据（平台 runner 注入，本地由 sim 注入；必填）
# ---------------------------------------------------------------------------
# OPENAI_API_KEY：API 密钥。本地必填；平台自动注入。
# OPENAI_API_KEY=

# OPENAI_BASE_URL：OpenAI 兼容网关地址。平台默认 https://api.arc-bench.com/v1
# OPENAI_BASE_URL=https://api.arc-bench.com/v1

# MODEL：主编码模型（deepseek-v4-flash / gpt-4o / ...）。
# 平台注入；本地若缺省则代码内回退为空（不可用）。
# MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# 二、执行复杂度档位（不在本文件：改 Codex/main.py 的 ARCBENCH_EFFORT_DEFAULT）
# ---------------------------------------------------------------------------
# 档位值：0=L0 1=L1A 2=L1B 3=L1C 4=L2，影响每个模块 prompt 的契约详细程度与
#   测试策略。ARCBENCH_EFFORT 环境变量已失效（平台不透传它，本地 .env 也进不了
#   产物，靠它切档会造成"以为跑了某一档"）。
#
#   L0  (0) —— 基线（旧行为）：完整 9 条契约 + 逐条证据罗列。最稳、最贵。
#   L1A (1) —— 保留测试（最保守）：只砍服务/浏览全项目/结论一行。
#   L1B (2) —— 折中：禁完整测试套件，允许一次 build/tsc 抓编译错。
#   L1C (3) —— 禁测试（最激进）：契约不变，禁跑测试套件。
#   L2  (4) —— 中减：契约压缩为四条铁律，免逐条证据。省 35–50%。
# 本地对照实验：把 main.py 载入成模块后改 `mod.ARCBENCH_EFFORT_DEFAULT = n`，
#   不要再设环境变量。
# ARCBENCH_EFFORT=0   # 已失效，仅作为"将被告警"的历史记录保留在本模板里

# ---------------------------------------------------------------------------
# 三、功能开关（全部改到 Codex/main.py 顶部 FEATURE_FLAGS 表）
# ---------------------------------------------------------------------------
# 下面这些键**不再被读取**，列在这里只是为了让你知道去哪改、以及旧值是多少：
#   ARCBENCH_FRONTEND_SPEC   -> FEATURE_FLAGS["frontend_spec"]            （旧默认 1）
#   ARCBENCH_VERIFY          -> FEATURE_FLAGS["verify_gate"]              （旧默认 1，评分兜底）
#   ARCBENCH_VISUAL          -> FEATURE_FLAGS["visual"]                   （现值 False）
#   ARCBENCH_TELEMETRY       -> FEATURE_FLAGS["telemetry"]                （旧默认 0）
#   ARCBENCH_VERBOSE         -> FEATURE_FLAGS["verbose_log"]              （旧默认 0）
#   ARCBENCH_CODEX_ROLLOUTS  -> FEATURE_FLAGS["codex_rollouts"]           （旧默认 1）
#   ARCBENCH_PROMPT_COMPACT  -> FEATURE_FLAGS["prompt_compact"]           （S1a，现值 True）
#   ARCBENCH_CONTRACT_INLINE -> FEATURE_FLAGS["contract_inline"]          （S1b，现值 False=外置）
#   ARCBENCH_TEMPLATE_KIT    -> FEATURE_FLAGS["template_kit"]             （S2'，现值 True）
#   ARCBENCH_CONTRACT_INDEX  -> FEATURE_FLAGS["contract_index"]           （S5，现值 True）
#   ARCBENCH_CONTRACT_INDEX_ADVISORY -> 已删除（S5 的 advisory 走 CLI --advisory）
#   ARCBENCH_CONTRACT_PROBES -> FEATURE_FLAGS["contract_probes"]          （S3'，现值 True）
#   ARCBENCH_VERIFY_BROWSER  -> FEATURE_FLAGS["verify_browser_install"]    （现值 False）
# 本次 run 的生效值看日志一行：`[codex] features: effort=..., ...`（全量渲染）。

# ---------------------------------------------------------------------------
# 四、视觉分析模型（缺省逐级回退主模型；仅在 main.py 表内 visual=True 且子树
#     引用图片时才会真正调用）
# ---------------------------------------------------------------------------
# VISUAL_MODEL：视觉模型，如 kimi-k3。缺省回退 MODEL。
# VISUAL_MODEL=kimi-k3

# VISUAL_API_KEY：视觉模型密钥。缺省回退 OPENAI_API_KEY。
# VISUAL_API_KEY=

# VISUAL_BASE_URL：视觉模型网关。缺省回退 OPENAI_BASE_URL，再回退 OPENAI_API_BASE。
# VISUAL_BASE_URL=https://api.arc-bench.com/v1

# ---------------------------------------------------------------------------
# 五、verify gate 调优（Codex/verify/verify.py 读取；一般不用动）
# ---------------------------------------------------------------------------
# ARCBENCH_VERIFY_PORT：verify 冒烟用的后端端口。默认 3199。
# ARCBENCH_VERIFY_PORT=3199

# ARCBENCH_VERIFY_TEST_TIMEOUT：L1 npm test 超时（秒）。默认 420。
# ARCBENCH_VERIFY_TEST_TIMEOUT=420

# ARCBENCH_VERIFY_BUILD_TIMEOUT：L2 前端构建超时（秒）。默认 300。
# ARCBENCH_VERIFY_BUILD_TIMEOUT=300

# ARCBENCH_VERIFY_SERVER_TIMEOUT：冒烟启动后端等待（秒）。默认 60。
# ARCBENCH_VERIFY_SERVER_TIMEOUT=60

# ARCBENCH_VERIFY_SMOKE_TIMEOUT：L2 浏览器冒烟总超时（秒）。默认 120。
# ARCBENCH_VERIFY_SMOKE_TIMEOUT=120

# ARCBENCH_VERIFY_BROWSER 已移到 main.py 表内 FEATURE_FLAGS["verify_browser_install"]。

# ---------------------------------------------------------------------------
# 六、运行时自动注入、请勿手改（runner/sim 会设置）
# ---------------------------------------------------------------------------
# ARCBENCH_TASK_TYPE：任务类型，默认 web（main.py 读）。
# ARCBENCH_OUTPUT_DIR / ARCBENCH_PROJECT_DIR / ARCBENCH_TEMPLATE_DIR：工作目录。
# ARCBENCH_RUNNER_EVENTS_PATH / ARCBENCH_TRACEABILITY_DIR：遥测路径（telemetry=1 时用）。
# OPENAI_API_BASE：visual_refs 的第三级 base_url 回退。

# ---------------------------------------------------------------------------
# 七、透传前缀参考（本地 sim 会把宿主机/本文件中这些前缀的变量注入容器）
#     OPENAI_ / ARCBENCH_ / ARC_ / MODEL / OCTOS_ / MINIMALIST_ /
#     VISUAL_ / EXTRA_ / TDD_ / NQ_ / PLAYWRIGHT_
#     —— 其他路线的变量放这里不生效。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 八、省 token / 契约能力（2026-09-22 起全部默认开启；2026-09-23 起改由代码配置）
# ---------------------------------------------------------------------------
# 这一节曾经放六个 ARCBENCH_* 开关键，现已全部迁到 Codex/main.py 顶部的
# FEATURE_FLAGS 表（对照关系见第三节）。留在这里的键一律不参与判定，而且会在
# 启动时打一条"已忽略"告警——所以请把 .env 里这些行删掉或注释掉。
#
# 实测收益没有变化（2026-09-23 复跑）：
#   各语料 prompt 缩减 44.8%~64.6%，契约文件 7448B，
#   模板含 kit 31 文件、不含 kit 26 文件且与"模板减 kit"逐字节全等。
# 逐字节等价证据：38 项全通过，含"环境变量影响为 0"与"表内回退 == HEAD 对应模式"两类。
